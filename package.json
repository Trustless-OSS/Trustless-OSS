    "globals": "^16.4.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.0.0",
    "ip-address": "^10.3.1",
    "jsdom": "^30.0.1",
    "lint-staged": "^15.0.0",
    "nanoid": "^3.3.18",
    "prettier": "^3.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "undici": "^7.29.0",
