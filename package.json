    "react-icons": "^5.7.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.29.0"
  },
  "dependenciesMeta": {
    "undici": {
      "optional": false
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
