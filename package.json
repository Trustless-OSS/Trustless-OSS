{
  "name": "trustless-oss",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.enabled=true --coverage.provider=v8 --coverage.include=app/components/escrow/RepositoryEscrowCard.tsx --coverage.include=app/components/escrow/EscrowEventLog.tsx --coverage.include=lib/event-stream.ts --coverage.thresholds.lines=90 --coverage.thresholds.functions=90 --coverage.thresholds.branches=90 --coverage.thresholds.statements=90",
    "lint": "eslint 'app/**/*.{ts,tsx}' 'lib/**/*.{ts,tsx}' --max-warnings=-1",
    "lint:fix": "eslint 'app/**/*.{ts,tsx}' 'lib/**/*.{ts,tsx}' --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '**/*.{ts,tsx}'",
    "format:check": "prettier --check '**/*.{ts,tsx}'",
    "audit": "pnpm audit --audit-level=high",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm run audit",
    "clean": "rm -rf .next out"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.2.0",
